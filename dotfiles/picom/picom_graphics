# --- Backend ---
# Si en la VM tienes problemas gráficos (parpadeos), cambia "glx" por "xrender"
backend = "glx";
vsync = true;

# --- Sombras (Shadows) ---
shadow = true;
shadow-radius = 12;
shadow-offset-x = -10;
shadow-offset-y = -10;
# ERROR CORREGIDO: La opacidad va de 0.0 a 1.0. (1.5 no es válido)
shadow-opacity = 0.7;
# shadow-color = "#8dff33"

# --- Blur (Desenfoque) ---
blur-background = true;
# dual_kawase consume GPU. Si la VM va lenta, comenta estas líneas.
blur-method = "dual_kawase";
# AJUSTE: Bajado a 3 para que no se vea tan "emborronado"
blur-strength = 3; 

# Excluir el blur en menús contextuales ayuda a que se vea más limpio
blur-background-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "class_g = 'Slop'",
  "_GTK_FRAME_EXTENTS@:c"
];

# --- Bordes Redondeados ---
corner-radius = 8;
round-borders = 8;
rounded-corners-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'"
];

# --- Opacidad ---
# Si sientes que se ve "muy opaco", es porque estas reglas estaban comentadas.
# Aquí definimos qué apps tendrán transparencia.
opacity-rule = [
    "90:class_g = 'kitty'",
    "90:class_g = 'Alacritty'",
    "95:class_g = 'Rofi'",
    "85:class_g = 'Thunar'"
];

# Opacidad global (Déjalas en 1.0 y usa opacity-rule para controlar apps específicas)
inactive-opacity = 1.0
frame-opacity = 1.0
active-opacity = 1.0
inactive-opacity-override = false;

# --- Fading (Desvanecimiento) ---
fading = true;
fade-in-step = 0.04;
fade-out-step = 0.03;

# --- Otros ajustes técnicos ---
use-damage = true;
mark-wmwin-focused = true;
mark-ovredir-focused = true;
detect-client-opacity = true;
detect-transient = true;
detect-rounded-corners = true;
detect-client-leader = true;

# Esto ayuda a evitar "tearing" y glitches en VMs
xrender-sync-fence = true;

log-level = "warn";
