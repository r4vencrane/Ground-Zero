#################################
#    CLEAN GLASS / NO SHADOW    #
#################################

# --- Backend (Calidad Gráfica) ---
backend = "glx";
vsync = true;

# --- Sombras (DESACTIVADAS) ---
shadow = false;

# --- Blur (El protagonista visual) ---
blur-background = true;
blur-method = "dual_kawase";
blur-strength = 4;  # Nivel 4 es un punto dulce: muy estético y legible.

# Exclusiones obligatorias para que no se vea feo en menús
blur-background-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "class_g = 'Slop'",
  "class_g = 'firefox'",
  "_GTK_FRAME_EXTENTS@:c"
];

# --- Bordes Redondeados ---
corner-radius = 10;
round-borders = 1;

rounded-corners-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'"
];

# --- Opacidad ---
inactive-opacity = 1.0
frame-opacity = 1.0
opacity = 1.0
active-opacity = 1.0
inactive-opacity-override = false;

# REGLAS DE CRISTAL:
# Como no hay sombras, el blur es lo único que separa las ventanas del fondo.
opacity-rule = [
    # Menú de aplicaciones (Estilo moderno)
    "95:class_g = 'Rofi'",
    
    # Exploradores de archivos
    "90:class_g = 'Thunar'",
    "90:class_g = 'Nautilus'",
    "90:class_g = 'Pcmanfm'",
    
    # (Opcional) Si quieres que Spotify o VSCode tengan cristal:
    "95:class_g = 'Code'",
    "90:class_g = 'Spotify'"
];

# --- Fading (Animaciones) ---
# Al no haber sombras, la animación suave es vital para que no se sienta "seco".
fading = true;
fade-in-step = 0.03;
fade-out-step = 0.03;
fade-delta = 5;

# --- Ajustes Técnicos ---
use-damage = true;
mark-wmwin-focused = true;
mark-ovredir-focused = true;
detect-client-opacity = true;
detect-transient = true;
detect-rounded-corners = true;
detect-client-leader = true;

# Evita tearing y parpadeos
xrender-sync-fence = true;

log-level = "warn";
