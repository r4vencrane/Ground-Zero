#################################
#   LOW SPEC / PERFORMANCE MODE #
#################################

# --- Backend ---
# Usamos glx optimizado. Si notas lag, cambia a "xrender".
backend = "glx";
vsync = true;

# Optimizaciones CRÍTICAS para rendimiento
#glx-no-stencil = true;
#glx-no-rebind-pixmap = true;
use-damage = true; # Solo renderiza lo que cambia en pantalla

# Si vas a jugar o ver videos en pantalla completa, 
# esto apaga picom temporalmente para darte máximos FPS:
unredir-if-possible = true;

# --- Sombras (Shadows) ---
# Sombras pequeñas y nítidas (menos carga para la GPU)
shadow = true;
shadow-radius = 7;
shadow-offset-x = -7;
shadow-offset-y = -7;
shadow-opacity = 0.6;

shadow-exclude = [
    "name = 'Notification'",
    "class_g = 'Conky'",
    "class_g ?= 'Notify-osd'",
    "class_g = 'Cairo-clock'",
    "_GTK_FRAME_EXTENTS@:c"
];

# --- Fading (Transiciones) ---
# Hacemos el fading MUY rápido para que el sistema se sienta "snappy" (ágil)
fading = true;
fade-in-step = 0.05;
fade-out-step = 0.05;
fade-delta = 4;

# --- Blur (DESACTIVADO) ---
# El blur mata el rendimiento en PCs viejas. 
# Lo apagamos para garantizar fluidez.
blur-background = false;

# --- Bordes ---
# Redondeo sutil. Si usas 'xrender' y se ven feos, cambia esto a 0.
corner-radius = 6;
round-borders = 1;
rounded-corners-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'"
];

# --- Opacidad y Dimming (El truco visual) ---

inactive-opacity = 1.0;
active-opacity = 1.0;
frame-opacity = 1.0;
inactive-opacity-override = false;

# DIMMING: Oscurece las ventanas que no estás usando.
# Se ve genial y ayuda a concentrarse sin gastar recursos.
inactive-dim = 0.15; 

# Reglas de transparencia simple (Sin Blur)
# Al no haber blur, la transparencia es "barata" para el sistema.
opacity-rule = [
    # Si quieres que tu terminal sea transparente siempre:
    # "90:class_g = 'kitty'", 
    # "90:class_g = 'Alacritty'",
    
    # Menús y carpetas
    "95:class_g = 'Rofi'",
    "90:class_g = 'Thunar'"
];

# --- Otros ajustes técnicos ---
mark-wmwin-focused = true;
mark-ovredir-focused = true;
detect-client-opacity = true;
detect-transient = true;
detect-rounded-corners = true;
detect-client-leader = true;

# Evitar tearing
xrender-sync-fence = true;

log-level = "warn";
