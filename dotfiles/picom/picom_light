########################################
# BACKEND & SYNC
########################################
backend = "xrender";   # más compatible en VM, menos consumo que glx
vsync = true;

########################################
# SHADOWS
########################################
shadow = false;        # desactivamos sombras (pesadas en VM)

########################################
# BLUR
########################################
blur-method = "dual_kawase";
blur-size = 3;
blur-strength = 4;
blur-background = true;
blur-background-frame = false;
blur-background-fixed = false;

########################################
# CORNERS & BORDERS
########################################
corner-radius = 6;
round-borders = 0;

########################################
# OPACITY
########################################
inactive-opacity = 0.90;
active-opacity = 0.95;
frame-opacity = 0.90;
inactive-opacity-override = false;

# Reglas de transparencia para terminales
opacity-rule = [ "90:class_g = 'kitty'", "90:class_g = 'Alacritty'" ];

########################################
# FADING
########################################
fading = true;
fade-in-step = 0.03;
fade-out-step = 0.03;

########################################
# GENERAL
########################################
use-damage = true;
mark-wmwin-focused = true;
mark-ovredir-focused = true;
detect-client-opacity = true;
detect-transient = true;
detect-rounded-corners = true;
detect-client-leader = true;

#glx-no-stencil = true;
#glx-no-rebind-pixmap = true;
xrender-sync-fence = true;

log-level = "warn";
